# Keep secrets, local state and bulky artefacts out of the build context (and therefore out of images).
.git
.github
.env
.env.*
!.env.example
!.env.production.example
backups
ml/models
ml/datasets
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
frontend/node_modules
frontend/.next
docs
