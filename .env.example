# QueueCare environment template.
# Copy to `.env` and replace every CHANGE_ME value. NEVER commit `.env`.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(64))"

# ---------- General ----------
APP_ENV=development                 # development | production
DEBUG=false
LOG_LEVEL=INFO
DEMO_MODE=true                      # labels UI as a synthetic-data demonstration

# ---------- PostgreSQL ----------
POSTGRES_DB=queuecare
POSTGRES_USER=queuecare_owner       # owns schema; used by migrations only
POSTGRES_PASSWORD=CHANGE_ME_OWNER_PASSWORD
APP_DB_USER=queuecare_app           # runtime role: no BYPASSRLS, not table owner
APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
DATABASE_URL=postgresql+psycopg://queuecare_app:CHANGE_ME_APP_PASSWORD@postgres:5432/queuecare
MIGRATION_DATABASE_URL=postgresql+psycopg://queuecare_owner:CHANGE_ME_OWNER_PASSWORD@postgres:5432/queuecare
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ---------- Redis ----------
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# ---------- Auth ----------
JWT_SECRET=CHANGE_ME_64_BYTE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false                 # MUST be true in production (HTTPS)
COOKIE_SAMESITE=lax                 # lax | strict | none
COOKIE_DOMAIN=
CSRF_SECRET=CHANGE_ME_CSRF_SECRET
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---------- CORS / URLs ----------
BACKEND_CORS_ORIGINS=http://localhost:3000     # comma-separated explicit origins, no wildcards
FRONTEND_URL=http://localhost:3000
MAX_REQUEST_BODY_BYTES=1048576

# ---------- Notifications (mock providers by default) ----------
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
# Real provider credentials go in deployment secrets only, never here.

# ---------- ML ----------
ML_MODEL_DIR=/app/ml/models

# ---------- Frontend (public values only!) ----------
# Anything prefixed NEXT_PUBLIC_ is visible in the browser. Never put secrets here.
NEXT_PUBLIC_API_BASE_URL=/api/v1                # same-origin; the Next dev server proxies it to the backend
NEXT_PUBLIC_WS_URL=ws://localhost:8000   # API origin only (the path comes from the server). Leave empty behind the production proxy
NEXT_PUBLIC_DEMO_MODE=true

# --- Notifications (Phase 8). Providers are mocks: nothing is ever sent.
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_POLL_INTERVAL_SECONDS=2.0
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BACKOFF_BASE_SECONDS=30
NOTIFICATION_LEASE_SECONDS=120
NOTIFICATION_REMINDER_HOURS=24
NOTIFICATION_RETENTION_DAYS=30
