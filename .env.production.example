# QueueCare PRODUCTION environment template. Copy to `.env.production` (git-ignored) and run
# `scripts/generate-secrets.sh` to fill every CHANGE_ME with random values. NEVER commit `.env.production`.
# The application refuses to start in production with placeholders, short secrets, insecure cookies or http:// origins.

# ---------- Public address ----------
DOMAIN=queuecare.example.com        # DNS A/AAAA record must point at this host. Use `localhost` to rehearse locally.
ACME_EMAIL=ops@example.com          # Let's Encrypt expiry notices (leave empty for localhost)

# Host ports Caddy listens on. Keep 80/443 on a real server. For a local rehearsal on Windows where those are taken,
# use HTTP_PORT=8080 and HTTPS_PORT=8443, and put the port in BACKEND_CORS_ORIGINS/FRONTEND_URL (https://localhost:8443).
HTTP_PORT=80
HTTPS_PORT=443

# ---------- General ----------
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
DEMO_MODE=true                      # keeps the "synthetic data" labelling on; QueueCare has no real-patient certification

# ---------- PostgreSQL ----------
POSTGRES_DB=queuecare
POSTGRES_USER=queuecare_owner       # owns the schema; used by the migrate job only
POSTGRES_PASSWORD=CHANGE_ME_OWNER_PASSWORD
APP_DB_USER=queuecare_app           # runtime role: no BYPASSRLS, not table owner (row-level security always applies)
APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
DATABASE_URL=postgresql+psycopg://queuecare_app:CHANGE_ME_APP_PASSWORD@postgres:5432/queuecare
MIGRATION_DATABASE_URL=postgresql+psycopg://queuecare_owner:CHANGE_ME_OWNER_PASSWORD@postgres:5432/queuecare
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ---------- Redis ----------
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# ---------- Auth ----------
JWT_SECRET=CHANGE_ME_64_BYTE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CSRF_SECRET=CHANGE_ME_CSRF_SECRET
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---------- CORS / URLs (explicit https origins, no wildcards) ----------
BACKEND_CORS_ORIGINS=https://queuecare.example.com
FRONTEND_URL=https://queuecare.example.com
MAX_REQUEST_BODY_BYTES=1048576

# ---------- Notifications ----------
# Providers are MOCKS: nothing is ever sent. Real email/SMS providers are not built (see docs/notifications.md).
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_POLL_INTERVAL_SECONDS=2.0
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BACKOFF_BASE_SECONDS=30
NOTIFICATION_LEASE_SECONDS=120
NOTIFICATION_REMINDER_HOURS=24
NOTIFICATION_RETENTION_DAYS=30

# ---------- ML ----------
ML_MODEL_DIR=/app/ml/models         # mounted read-only from the `ml_models` volume; empty = labelled heuristic fallback
