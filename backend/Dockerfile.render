# The image Render builds for the free hosted demo (see docs/deployment-free.md). Build context is the repository root.
# Why a separate file: backend/Dockerfile keeps its development stage LAST so a plain `docker compose build` gives the dev image, and
# Render builds the last stage. This file ends with the production stage, and its start command also applies the database migrations
# (a free Render service has no separate pre-deploy step), as the OWNER role from MIGRATION_DATABASE_URL, then starts the API.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MPLCONFIGDIR=/tmp \
    NUMBA_CACHE_DIR=/tmp

WORKDIR /app

# libgomp is required by LightGBM
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install -r /app/backend/requirements.txt

COPY backend /app/backend
COPY ml /app/ml

RUN useradd --create-home --uid 10001 appuser && chown -R appuser /app
USER appuser

WORKDIR /app/backend
ENV PYTHONPATH=/app/backend:/app

# ONE worker, on purpose: the outbox relay and the notification worker run inside the process, and a free Render service is a
# single instance anyway. Render tells the container which port to listen on through $PORT (10000 by default).
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-10000} --no-server-header --timeout-graceful-shutdown 20"]
